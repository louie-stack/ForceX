# Upstream ForceX data API (server-side proxy target). Leave as-is unless pointing at a staging host.
FX_API_ORIGIN=https://forcex.com

# Where deep explorer/app links (blocks, transactions, addresses, Xamine, account) resolve.
NEXT_PUBLIC_FX_APP_ORIGIN=https://forcex.com

# Auth service used by the sign-in / sign-up forms.
NEXT_PUBLIC_FX_AUTH_ORIGIN=https://auth.forcex.com

# Cloudflare Turnstile site key for the sign-up form. Must be registered for the domain the site is served from.
# NEXT_PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAADKTXU2zKEgD5zor

# Xtract API bearer token (create one on forcex.com). Server-side only. Without it, Xamine charts
# and Address LinX show labelled sample data. Address LinX only spends it for signed-in viewers.
# FX_API_KEY=
